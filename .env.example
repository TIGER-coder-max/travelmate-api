# ─── TravelMate Nepal API — Environment Variables ─────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=https://sanketpokharel.com.np

# Database (Render gives you this automatically)
DATABASE_URL=postgresql://user:password@host:5432/travelmate

# JWT Secret — make this long and random
JWT_SECRET=change_this_to_a_long_random_string_minimum_32_chars

# Stripe (get from stripe.com — use test keys first)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# eSewa (get from esewa.com.np/merchant)
ESEWA_MERCHANT_CODE=EPAYTEST

# Khalti (get from khalti.com/merchants)
KHALTI_SECRET_KEY=live_secret_key_...

# Email — Gmail SMTP (enable App Password in Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
